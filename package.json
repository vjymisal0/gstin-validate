{
  "name": "gst-validator",
  "version": "1.0.4",
  "description": "Validate and parse Indian GSTIN numbers, including checksum verification and the embedded PAN",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./src/index.d.cts",
        "default": "./src/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "gstin",
    "gst",
    "india",
    "validator",
    "kyc",
    "tax-id"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vjymisal0/gstin-validate.git"
  },
  "homepage": "https://github.com/vjymisal0/gstin-validate#readme",
  "bugs": {
    "url": "https://github.com/vjymisal0/gstin-validate/issues"
  },
  "author": "Vijay Misal <misalvijay153@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "pan-card-validator": "1.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
